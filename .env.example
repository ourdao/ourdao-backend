# OurDAO backend configuration
# Copy to .env and fill in.

# --- HTTP API ---
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed CORS origins (the frontend URL). "*" allows all.
CORS_ORIGIN=http://localhost:3000
# Pino log level for the Fastify server (fatal, error, warn, info, debug, trace, silent).
# 'info' logs a line per request. 'silent' suppresses all request logging.
LOG_LEVEL=info
# Optional bearer token for GET /metrics. When set, requests without
# "Authorization: Bearer <token>" are rejected with 401. Leave unset for
# internal/trusted deployments where the port is not publicly reachable (issue #353).
# METRICS_TOKEN=
# Max time (ms) /ready waits for its Postgres probe before reporting postgres_timeout (default 3000; issue #167).
READY_CHECK_TIMEOUT_MS=3000

# --- Postgres ---
# Either a single connection string...
DATABASE_URL=postgres://ourdao:ourdao@localhost:5432/ourdao
# Optional shared cache for GET /api/stats/history (one-hour TTL).
REDIS_URL=redis://localhost:6379
# TTL (seconds) of the optional Redis cache for the members list and per-address summary (issue #277).
MEMBER_CACHE_TTL_SECONDS=30
# TTL (seconds) of the Redis/in-process cache for GET /api/stats/history (issue #504).
# Defaults to 3600; must be a positive integer. Shares REDIS_URL above.
HISTORY_CACHE_TTL_SECONDS=3600
# ...or leave DATABASE_URL empty and set these individually:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=ourdao
# PGPASSWORD=ourdao
# PGDATABASE=ourdao
# Nonce store backend: "postgres" (production, multi-instance) or "memory" (dev/testing).
# Postgres keeps nonces across API instances and survives restarts; memory is ephemeral.
# Defaults to "postgres" (issue #66).
# Max size of the shared Postgres request pool (defaults to 10; issue #152).
DB_POOL_MAX=10
# Max time (ms) to wait for a free connection from the pool before failing (default 5000; issue #167).
DB_CONNECTION_TIMEOUT_MS=5000
# Server-side statement_timeout (ms) applied to every pool connection (default 10000; issue #167).
DB_STATEMENT_TIMEOUT_MS=10000
NONCE_STORE=postgres
# Nonce time-to-live in milliseconds (issue #181). Default is 5 minutes.
NONCE_TTL_MS=300000
# Max outstanding nonces stored (memory store) or per-address (issue #181). Default is 10000.
NONCE_MAX_ENTRIES=10000
# Interval (ms) for background cleanup of expired nonces (issue #181). Default is 1 minute.
NONCE_SWEEP_INTERVAL_MS=60000

# --- Tracing ---
# When true, the API and indexer emit OpenTelemetry-shaped spans as JSON log
# lines ([otel] span ...). Off by default: with it off the tracer is a shared
# no-op, so there is no per-request overhead.
OTEL_ENABLED=false

# --- Stellar / Soroban ---
# Deployed OurDAO contract id (starts with C). REQUIRED for the indexer to run.
CONTRACT_ID=
# Comma-separated contract ids to tail in one indexer process (issue #289). Takes priority over CONTRACT_ID.
# CONTRACT_IDS=
# Soroban RPC endpoint (public testnet default).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Extra headers sent to the RPC, as comma-separated "Name:Value" pairs, e.g. for an API key (issue #284).
# STELLAR_RPC_HEADERS=
# Network passphrase. Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Nominal Stellar ledger close time in seconds, used by /ready to estimate lag (default 5; issue #139).
STELLAR_LEDGER_CLOSE_TIME_SECONDS=5

# --- Indexer ---
# Ledger to begin indexing from. 0 = start from (latest - START_LOOKBACK_LEDGERS).
# Note: public Soroban RPC only retains ~24h of events, so a very old start
# ledger will be clamped to the oldest ledger the RPC still serves.
START_LEDGER=0
START_LOOKBACK_LEDGERS=17280
# How often to poll getEvents, in milliseconds.
POLL_INTERVAL_MS=5000
# Max events fetched per getEvents page.
EVENTS_PAGE_LIMIT=100
# Cap (ms) for the exponential backoff applied after consecutive poll failures.
POLL_MAX_BACKOFF_MS=60000
# Max pages to drain per poll iteration when behind (issue #3).
DRAIN_MAX_PAGES=20
# Max wall-clock ms for a single drain cycle (issue #3).
DRAIN_MAX_MS=30000
# How long (ms) the indexer cursor can be idle before /ready reports stale.
INDEXER_STALE_AFTER_MS=120000
# After this many consecutive whole-page failures with the same error on the
# same page, the poller stops treating it as transient and quarantines the
# offending event(s) one-per-transaction instead of retrying forever (issue #43).
INDEXER_QUARANTINE_AFTER_FAILURES=3
# The contract has no upgrade path, so a fix means a new CONTRACT_ID. If the
# saved cursor belongs to a different contract, the indexer refuses to start
# rather than merge two deployments' state. Set this to "true" for one boot
# to wipe the cursor + derived tables and re-index the new contract from
# scratch (the raw events log is kept). See README "Redeploying the contract".
INDEXER_RESET_ON_CONTRACT_CHANGE=false
# Note: The indexer (worker process) uses console.log/console.error directly and
# does not respect LOG_LEVEL. Its output is always shown regardless of this setting.
# Loopback-only worker diagnostic listener for GET /ready (issue #503). It exposes
# the worker's in-memory cursor-write failures; the API process cannot see them.
WORKER_DIAGNOSTICS_HOST=127.0.0.1
WORKER_DIAGNOSTICS_PORT=4010

# --- Database pool (issue #196) ---
# Per-process pg pool size. The API also holds one extra connection for its SSE
# listener, and the worker has its own pool: budget worker_pool +
# api_instances x (DB_POOL_MAX + 1) against Postgres max_connections.
DB_POOL_MAX=10
# How long (ms) a caller waits for a free connection before failing.
DB_CONNECTION_TIMEOUT_MS=5000
# Server-side per-statement timeout (ms) for pooled connections. 0 disables.
# Reindex and migrations lift it for their own session/transaction.
DB_STATEMENT_TIMEOUT_MS=10000
# How long (ms) an idle pooled connection is kept before being closed. 0 disables.
DB_IDLE_TIMEOUT_MS=30000
# Shown in pg_stat_activity.application_name. Leave unset to get ourdao-api /
# ourdao-worker automatically; setting it in a .env shared by both processes
# makes them indistinguishable.
# DB_APPLICATION_NAME=
# Process role used to derive the default application_name (ourdao-<role>).
# src/worker.ts sets it to "worker" itself; leave unset for the API.
# OURDAO_PROCESS_ROLE=
# Max time (ms) migrate() (API and worker, on every boot) waits to acquire the
# migration advisory lock before giving up (default 30000; issue #590). Raise
# this for an unusually slow migration (a large ALTER on an existing database)
# or a contended environment.
MIGRATION_LOCK_TIMEOUT_MS=30000

# --- Rate limiting ---
# Global rate limit: max requests per window per IP.
RATE_LIMIT_MAX=100
# Rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Stricter limit for the heavy GET /api/events endpoint.
RATE_LIMIT_EVENTS_MAX=30
# How long (ms) an /api/stats result is cached in-process before recompute
# (issue #18). Reported figures are at most this stale. 0 disables the cache.
STATS_CACHE_MS=5000
# At most this many cache-miss /api/stats recomputations run per API process.
# Extra requests receive 503 + Retry-After instead of queueing behind them.
STATS_MAX_CONCURRENT=1
STATS_RETRY_AFTER_SECONDS=1
# Concurrent SSE stream bounds (issue #156). Each open /api/stream holds a
# dedicated Postgres LISTEN connection; these caps are the resource bound.
STREAM_MAX_CONNECTIONS=100
STREAM_MAX_CONNECTIONS_PER_IP=10
# Idle timeout (ms) for an SSE socket with no reads/writes. Heartbeats every
# 30s keep healthy clients alive; dead sockets are closed (issue #156).
STREAM_IDLE_TIMEOUT_MS=60000
# Retry-After (seconds) returned with 503 when a stream cap is hit.
STREAM_RETRY_AFTER_SECONDS=30
# The 30-second heartbeat interval and the channel set are fixed in
# src/api/stream.ts. LISTEN/NOTIFY requires a direct or session-pooled Postgres
# connection; transaction pooling cannot preserve the listener session.
# Set to "true" behind a reverse proxy so rate limits apply per client IP.
TRUST_PROXY=false

# --- Maintenance (issue #279) ---
# How often (ms) the worker runs VACUUM ANALYZE and sweeps expired auth nonces. Default weekly.
MAINTENANCE_INTERVAL_MS=604800000

# --- Telemetry (issue #288) ---
# OpenTelemetry tracing for the indexer's event processing; off unless set to "true".
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=ourdao-backend

# --- Tests ---
# Separate database `npm test` runs against (never the dev DB above). Create
# it once with: docker exec <db-container> psql -U ourdao -d postgres -c
# "CREATE DATABASE ourdao_test;"
TEST_DATABASE_URL=postgres://ourdao:ourdao@localhost:5432/ourdao_test

# --- Build and test tooling (normally set by Docker/CI, not operators) ---
# NODE_ENV=production
# SOURCE_COMMIT=git-sha
# BUILD_DATE=2026-01-01T00:00:00Z
# VITEST=true
# RUN_RPC_SMOKE=false
